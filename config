[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
[remote "origin_https"]
	url = https://github.com/shuo65/dragonclaws.cn.git
	fetch = +refs/heads/*:refs/remotes/origin_https/*
[remote "origin"]
	url = git@github.com:shuo65/dragonclaws.cn.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
